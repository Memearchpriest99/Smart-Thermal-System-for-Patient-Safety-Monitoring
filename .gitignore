# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Dataset — never commit raw sensor data or patient-related recordings
dataset/
dataset_raw/
datasets/
sessions/
data/
*.npz
*.mp4
*.xlsx

# Archives / large bundles (exceed GitHub's 100 MB limit)
*.zip

# Standalone annotator build artifacts (build/ and dist/ already ignored above)
release/
*.exe
*.pkg

# Trained model checkpoints (large binary files)
checkpoints/
*.thalg
*.pkl

# Generated outputs (figures, calibration files)
outputs/
*.png
*.jpg

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# pytest / coverage
.pytest_cache/
pytest-cache-files-*/
.coverage
htmlcov/

# mypy / ruff caches
.mypy_cache/
.ruff_cache/

# Local Claude Code config
.claude/

# LaTeX build artifacts / scratch reports
*.aux
*.toc
*.out
reports/*.log
reports/_test*
reports/_build.log

# X3D backend eval cache (regenerable, ~1.8GB)
scripts/_x3d_backend_cache/
